# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nidhione?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login/google/callback

# Cron Settings
PRICE_UPDATE_CRON="0 */6 * * *"  # Every 6 hours
SIP_EXECUTION_CRON="0 9 * * *"   # Daily at 9 AM
